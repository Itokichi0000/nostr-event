# ---- 必須 ----
# 公開URL（NIP-98の u タグ検証・チケットURL・Originチェックに使用。末尾スラッシュなし）
APP_URL=http://localhost:3000
DATABASE_URL=postgres://gather:gather@localhost:5432/gather
# テスト用DB（pnpm test が使用。開発DBとは分けること）
TEST_DATABASE_URL=postgres://gather:gather@localhost:5432/gather_test

# ---- Nostr ----
# 主催者のNIP-65書込リレーに加えて使うフォールバックリレー（カンマ区切り、2～4推奨）
# ローカル開発では `pnpm relay:dev` の ws://localhost:7777 を使えば外部に公開せず試せる
NOSTR_FALLBACK_RELAYS=ws://localhost:7777
# NIP-65 (kind:10002) とプロフィールの取得に使うインデックスリレー
NOSTR_INDEX_RELAYS=ws://localhost:7777
# NIP-46（スマホ署名アプリ）接続に使うリレー。ブラウザーから接続される
NEXT_PUBLIC_NIP46_RELAYS=wss://relay.nsec.app

# ---- Web Push（`pnpm vapid` で生成）----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- 画像アップロード（開発はローカルディスク）----
UPLOAD_DIR=./.data/uploads

# E2E（pnpm test:e2e）用DB。開発DBとは分ける
E2E_DATABASE_URL=postgres://gather:gather@localhost:5432/gather_e2e

# Gather 外の naddr を表示するとき、ブラウザーから読みに行くリレー
NEXT_PUBLIC_NOSTR_READ_RELAYS=wss://relay.damus.io,wss://nos.lol
